<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- LaunchTheme — app icon dikhata hai jab tak Flutter engine load ho
         raha hai. Section: standard Flutter template pattern. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- NormalTheme — Flutter fully load hone ke baad yeh apply hoti hai
         (MainActivity.kt mein io.flutter.embedding.android.NormalTheme
         meta-data isi ko reference karta hai). -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
